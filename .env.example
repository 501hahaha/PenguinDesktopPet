# Optional local QQ Bot configuration. Never replace these placeholders in Git.
PENGUIN_QQ_APP_ID=<SET_LOCALLY>
PENGUIN_QQ_CLIENT_SECRET=<SET_LOCALLY>
PENGUIN_QQ_ACCESS_TOKEN=<SET_LOCALLY>
PENGUIN_QQ_CHANNEL_ID=qq:<APP_ID>
PENGUIN_QQ_SANDBOX=0
PENGUIN_QQ_MAX_RETRY=5

# Optional local WeChat/Agent overrides.
PENGUIN_WECHAT_ENABLED=0
PENGUIN_WECHAT_TOKEN_FILE=<USER_DATA_DIR>/token.json
PENGUIN_WECHAT_DAEMON_LOG=<USER_DATA_DIR>/wechat-daemon.log
PENGUIN_WECHAT_DAEMON_PID_FILE=<USER_DATA_DIR>/wechat-daemon.pid
PENGUIN_WECHAT_AGENT_WORKSPACE=<PROJECT_DIR>
PENGUIN_WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
PENGUIN_WECHAT_CDN_URL=https://novac2c.cdn.weixin.qq.com/c2c
PENGUIN_WECHAT_CHANNEL_VERSION=1.0.2
PENGUIN_WECHAT_CLAUDE_URL=http://127.0.0.1:15721
PENGUIN_WECHAT_CLAUDE_MODEL=<MODEL_NAME>
